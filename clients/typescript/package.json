{
  "name": "@constellationspace/client",
  "version": "0.7.0",
  "description": "Constellation API client and workflow results bridge base for Node 18+ and browsers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/constellationhq/connectors.git",
    "directory": "clients/typescript"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./bridge": {
      "import": {
        "types": "./dist/bridge.d.ts",
        "default": "./dist/bridge.js"
      },
      "require": {
        "types": "./dist/bridge.d.cts",
        "default": "./dist/bridge.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run generate && tsup src/index.ts src/bridge.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript ../../contract/openapi.json --default-non-nullable false -o src/generated/api.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
