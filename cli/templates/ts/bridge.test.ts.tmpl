import { strict as assert } from "node:assert";
import { test } from "node:test";
import { MemoryCursorStore } from "@constellationspace/client/bridge";
import { {{.Class}}, manifest } from "./bridge.ts";

const run = { workflow: "w", workflow_version: 1, run_id: "run_20300101T000000_00000000" } as never;
const pass = (p10: number, facets = {}) =>
  ({ entity: { type: "pass", id: `pass_${p10}` }, target_at: "2030-01-01T00:00:00+00:00", value: { p10 }, ...facets }) as never;

test("apply writes the passes above the threshold", () => {
  const bridge = new {{.Class}}({ manifest, store: new MemoryCursorStore() });
  assert.deepEqual(bridge.apply([pass(1), pass(9)], { min_p10_gb: 5, label: "x" }, run), { passes: 1 });
});

test("act carries out an approved swap", () => {
  const bridge = new {{.Class}}({ manifest, store: new MemoryCursorStore() });
  const swap = { verb: "swap", from: "pass_9", to: "pass_backup", mode: "approve" };
  assert.equal(bridge.act(pass(9, { action: swap, action_status: "approved" }), {}, run), true);
});
