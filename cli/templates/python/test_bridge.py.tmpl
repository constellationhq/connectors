from pathlib import Path

from bridge import {{.Class}}

MANIFEST = Path(__file__).with_name("connector.json")
RUN = {"workflow": "w", "workflow_version": 1, "run_id": "run_20300101T000000_00000000"}


def item(p10, **facets):
    return {"entity": {"type": "pass", "id": f"pass_{p10}"}, "target_at": "2030-01-01T00:00:00+00:00",
            "value": {"p10": p10}, **facets}


def test_apply_writes_the_passes_above_the_threshold(tmp_path):
    bridge = {{.Class}}(MANIFEST, cursor_file=tmp_path / "cursor.txt")
    assert bridge.apply([item(1), item(9)], {"min_p10_gb": 5, "label": "x"}, RUN) == {"passes": 1}


def test_act_carries_out_an_approved_swap(tmp_path):
    bridge = {{.Class}}(MANIFEST, cursor_file=tmp_path / "cursor.txt")
    swap = {"verb": "swap", "from": "pass_9", "to": "pass_backup", "mode": "approve"}
    assert bridge.act(item(9, action=swap, action_status="approved"), {}, RUN) is True
