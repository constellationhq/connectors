"""{{.Title}}: a Constellation bridge. Write workflow results into your system in apply(), and carry out
approved actions in act(). Everything else (check-in, cursor, paging, reporting what act() did,
retries) is the Bridge base class in the constellation-space package."""

from pathlib import Path

from constellation_space.bridges.template import Bridge


class {{.Class}}(Bridge):
    def apply(self, items, settings, run):
        """Write one run's items into your system, keyed on item["entity"]["id"]; return what
        you wrote. The run is the whole answer for its window: withdraw what you wrote earlier
        for run["workflow"] inside the window that `items` no longer carries."""
        kept = [i for i in items if (i.get("value") or {}).get("p50", 0) >= settings.get("min_gb", 0)]
        for item in kept:
            print(f"{settings.get('label')}: {item['entity']['id']} at {item['target_at']}", flush=True)
        return {"passes": len(kept)}

    def act(self, item, settings, run):
        """Handle an approved action. Return True once done, or a reason (or False) when your
        system will not do it; an exception counts as a refusal too. Constellation shows "Sent
        to your MCS" or "Not sent to your MCS: <reason>". A swap is advice: "add" a backup pass
        and keep this one, or "move" to the backup. gain_gb is what it adds over doing nothing,
        deadline the time to decide by. Constellation books and cancels nothing; your system or
        team does. Each approval arrives here once."""
        action = item["action"]
        if action["verb"] == "swap" and action.get("action") == "move":
            # TODO: your booking calls go here: book the backup, then release this pass.
            pass
        elif action["verb"] == "swap":
            # TODO: your booking calls go here: book the backup and keep this pass.
            pass
        print(f"approved: {action['verb']} {action.get('from')} -> {action.get('to')}", flush=True)
        return True


def main():
    {{.Class}}(Path(__file__).with_name("connector.json")).run_forever()


if __name__ == "__main__":
    main()
