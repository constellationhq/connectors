# Builds openc3-cosmos-constellation-<VERSION>.gem: rake build VERSION=0.7.1
# (or ./openc3.sh cli rake build VERSION=0.7.1 inside a COSMOS checkout).
PLUGIN_NAME = Dir['*.gemspec'][0].split('.')[0..-2].join('.')

# The tool draws the shared Constellation Forecast view, copied in from this repo when it is here.
VIEW = 'tools/constellationforecast/forecast-view.js'
SHARED_VIEW = '../shared/forecast-view.js'
# The bridge imports the Python package's results module (constellation_space.results), copied in next to it
# the same way as a one-module constellation_space package.
RESULTS = 'microservices/BRIDGE/constellation_space/results.py'
SHARED_RESULTS = '../../clients/python/src/constellation_space/results.py'

task :build do
  abort('VERSION is required: rake build VERSION=0.7.1') unless ENV['VERSION']
  FileUtils.cp(SHARED_VIEW, VIEW) if File.exist?(SHARED_VIEW)
  abort("#{VIEW} is missing: copy bridges/shared/forecast-view.js there") unless File.exist?(VIEW)
  if File.exist?(SHARED_RESULTS)
    FileUtils.mkdir_p(File.dirname(RESULTS))
    FileUtils.cp(SHARED_RESULTS, RESULTS)
    FileUtils.touch(File.join(File.dirname(RESULTS), '__init__.py'))
  end
  abort("#{RESULTS} is missing: copy clients/python/src/constellation_space/results.py there") unless File.exist?(RESULTS)
  system("gem build #{PLUGIN_NAME}.gemspec") || abort('gem build failed')
end
