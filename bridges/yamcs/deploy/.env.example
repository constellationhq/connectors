# Copy to .env beside compose.yaml, fill it in, then docker compose up -d.
# Optional, default https://api.constellation.space. The Constellation API the key is for.
# CONSTELLATION_API_URL=https://api.constellation.space
# A Constellation API key with predictions:read.
CONSTELLATION_API_KEY=
# Where the bridge reaches your Yamcs, e.g. http://yamcs:8090.
YAMCS_URL=
# The Yamcs instance to write into, e.g. simulator.
YAMCS_INSTANCE=
# Optional, default yamcs-bridge. This connection's name; a workflow's mission control output names it.
# CONSUMER=yamcs-bridge
