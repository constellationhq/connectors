# Optional, default https://api.constellation.space. The Constellation API the key is for.
# CONSTELLATION_API_URL=https://api.constellation.space
# A Constellation API key with predictions:read and config:read.
CONSTELLATION_API_KEY=
# Your Lattice environment, https://<environment>.
LATTICE_URL=
# The environment's bearer token ("Lattice Auth Token" on the environment page).
LATTICE_TOKEN=
# Lattice Sandboxes only: the account bearer token (Sandboxes portal, Account & Security).
LATTICE_SANDBOX_TOKEN=
# Optional, default 0. The expected GB p10 floor a ReservePass decision uses for an antenna no
# workflow has forecast yet (a workflow's own floor wins once it forecasts the antenna).
# MIN_P10_GB=0
# Optional, default 21600 (6 hours, one weather-model cycle). The oldest forecast, in seconds since
# its run was made, a ReservePass decision may use; an older one is refused as STALE_FORECAST.
# MAX_FORECAST_AGE_S=21600
